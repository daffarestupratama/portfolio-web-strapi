{
  "kind": "collectionType",
  "collectionName": "service_packages",
  "info": {
    "singularName": "service-package",
    "pluralName": "service-packages",
    "displayName": "Service Package"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name" },
    "tagline": { "type": "text" },
    "kind": {
      "type": "enumeration",
      "enum": ["package", "bundle", "maintenance"],
      "default": "package",
      "required": true
    },
    "billing": {
      "type": "enumeration",
      "enum": ["one_time", "monthly", "yearly"],
      "default": "one_time"
    },
    "startingPrice": { "type": "decimal" },
    "priceQualifier": {
      "type": "enumeration",
      "enum": ["fixed", "starts_from"],
      "default": "fixed"
    },
    "currency": {
      "type": "enumeration",
      "enum": ["IDR", "USD"],
      "default": "IDR"
    },
    "includes": { "type": "json" },
    "timeline": { "type": "string" },
    "revisions": { "type": "string" },
    "suitableFor": { "type": "text" },
    "isPopular": { "type": "boolean", "default": false },
    "isActive": { "type": "boolean", "default": true },
    "order": { "type": "integer" }
  }
}
