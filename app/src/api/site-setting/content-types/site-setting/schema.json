{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string"
    },
    "defaultSeo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "authorAvatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "contactCta": {
      "type": "component",
      "component": "shared.contact-cta",
      "repeatable": false
    },
    "contactLinks": {
      "type": "component",
      "component": "shared.contact-link",
      "repeatable": true
    },
    "footerText": {
      "type": "text"
    },
    "copyrightText": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "whatsappUrl": {
      "type": "string"
    }
  }
}
