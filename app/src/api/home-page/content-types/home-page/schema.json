{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "headline": {
      "type": "string"
    },
    "subheadline": {
      "type": "text"
    },
    "heroCtaPrimary": {
      "type": "component",
      "component": "shared.cta",
      "repeatable": false
    },
    "heroCtaSecondary": {
      "type": "component",
      "component": "shared.cta",
      "repeatable": false
    },
    "featuredProjects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project"
    },
    "featuredArticles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
