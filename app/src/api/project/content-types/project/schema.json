{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "component",
      "component": "shared.gallery-image",
      "repeatable": true
    },
    "problem": {
      "type": "text"
    },
    "approach": {
      "type": "blocks"
    },
    "result": {
      "type": "blocks"
    },
    "technologies": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::skill.skill",
      "inversedBy": "projects"
    },
    "projectType": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "data_science",
        "data_visualization",
        "dashboard",
        "machine_learning",
        "gis",
        "web",
        "research",
        "case_study",
        "social_work",
        "finance",
        "other"
      ]
    },
    "projectStatus": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "planned",
        "in_progress",
        "completed",
        "archived"
      ]
    },
    "year": {
      "type": "integer",
      "required": true
    },
    "githubUrl": {
      "type": "string"
    },
    "liveDemoUrl": {
      "type": "string"
    },
    "resources": {
      "type": "component",
      "component": "shared.project-resource",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "relatedArticles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "inversedBy": "relatedProjects"
    }
  }
}
