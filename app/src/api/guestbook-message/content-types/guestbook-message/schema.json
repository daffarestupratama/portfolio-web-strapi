{
  "kind": "collectionType",
  "collectionName": "guestbook_messages",
  "info": {
    "singularName": "guestbook-message",
    "pluralName": "guestbook-messages",
    "displayName": "Guestbook Message"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "message": {
      "type": "text",
      "minLength": 3,
      "maxLength": 1000,
      "required": true
    },
    "displayName": {
      "type": "string",
      "maxLength": 50
    },
    "isPinned": {
      "type": "boolean",
      "required": false,
      "default": false
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "feedback",
        "question",
        "career",
        "personal",
        "tour",
        "website",
        "other"
      ]
    },
    "reply": {
      "type": "text"
    },
    "moderationStatus": {
      "type": "enumeration",
      "default": "visible",
      "enum": [
        "visible",
        "hidden",
        "spam"
      ]
    }
  }
}
