# ============================================
# Strapi backend - environment template
# Salin ke .env lalu isi nilainya.
# JANGAN commit .env.
# hanya file .example ini yang masuk Git.
# Saat migrasi, gunakan value LAMA persis, jangan generate ulang.
# ============================================

HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# --- Secrets (WAJIB sama dengan instalasi lama) ---
# APP_KEYS berisi 4 kunci dipisah koma
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# --- Database ---
# DATABASE_HOST = nama service di docker-compose, bukan localhost
DATABASE_CLIENT=postgres
DATABASE_HOST=strapi-db
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=
DATABASE_SSL=false

# --- Public URL ---
PUBLIC_URL=https://cms.daffa.me